<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns the real theming; this only styles the pre-Compose window so
         the launch transition matches ClariFi's dark background instead of flashing white. -->
    <style name="Theme.ClariFi" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
